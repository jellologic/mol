#!/usr/bin/make -f
# Toolchain from rustup when present (containers, dev boxes); archive
# builders provide /usr/bin/cargo via Build-Depends. debuild
# sanitizes PATH, hence the explicit prepend.
export PATH := $(HOME)/.cargo/bin:$(PATH)
# Build outputs stay out of the source tree (also keeps bind-mounted
# checkouts clean when verifying in docker).
CARGO_TARGET_DIR ?= /tmp/mol-target
export CARGO_TARGET_DIR

%:
	dh $@

override_dh_auto_build:
	cargo build --release --offline --frozen -p mol-loader

override_dh_auto_install:
	install -D -m0755 $(CARGO_TARGET_DIR)/release/mol-loader debian/mol/usr/bin/mol-loader
